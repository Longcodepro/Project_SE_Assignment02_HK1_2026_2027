# Cổng mở ra máy host
BACKEND_PORT=4003
FRONTEND_PORT=4004
DB_PORT=4005

# PostgreSQL
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change_me
POSTGRES_DB=brewlite

# Auth (Task 7)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Chỉ dùng khi chạy backend ngoài Docker (npm run start:dev)
# DATABASE_URL=postgresql://brewlite:change_me@localhost:4005/brewlite
# Hoặc kết nối Neon Cloud PostgreSQL (thay bằng connection string thật của bạn, KHÔNG commit):
# DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require&channel_binding=require"
