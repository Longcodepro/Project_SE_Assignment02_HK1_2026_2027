@startuml
' ==============================================================================
' Diagram: Sơ đồ Class Domain — Mô hình dữ liệu nghiệp vụ BrewLite (Task 2.3)
' Code: Class-01 | Issue: [D2.3] Task 2.3
' Yêu cầu chức năng liên quan: FR-01, FR-02, FR-03, FR-04, FR-05, FR-06, FR-07,
'   FR-08, FR-09, FR-10 (MVP); FR-11, FR-21 (Sprint 3, Planned, đánh dấu riêng)
' Tài liệu đối chiếu: docs/requirements/context-and-scope.md (mục 6), docs/requirements/requirements-api.md
' ==============================================================================
!theme plain
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12
skinparam roundcorner 10
skinparam shadowing false
skinparam classAttributeIconSize 0

skinparam ClassBorderThickness 1.2
skinparam ClassBorderColor #34495E
skinparam ClassBackgroundColor #FFFFFF
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.2

' ========================================================
' ENUMS (DANH MỤC TRẠNG THÁI & HÌNH THỨC)
' ========================================================
enum Role <<Enum>> #F3E5F5 {
  CUSTOMER
  BARISTA
  CASHIER
  MANAGER
}

enum OrderStatus <<Enum>> #F3E5F5 {
  PENDING
  PAID
  PAYMENT_FAILED
  ..Sprint 3, Planned..
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum Size <<Enum>> #F3E5F5 {
  S
  M
  L
}

enum PaymentMethod <<Enum>> #F3E5F5 {
  CARD
  WALLET
}

enum PaymentStatus <<Enum>> #F3E5F5 {
  SUCCESS
  FAILED
}

enum DiscountType <<Enum>> #EDE7F6 {
  FIXED
  PERCENT
}

' ========================================================
' CORE DOMAIN CLASSES (CÁC THỰC THỂ CỐT LÕI, MVP SPRINT 1-2)
' ========================================================
class User <<Core Entity>> #E8F8F5 {
  + phone : String [PK, 10 digits]
  - passwordHash : String
  + name : String?
  + role : Role = CUSTOMER
  + loyaltyPoints : Int = 0
  + email : String? {Tùy chọn, không duy nhất}
  + createdAt : DateTime
  __
  + register(phone, password)
  + login(phone, password)
  + getProfile()
  + addLoyaltyPoints(pts: Int)
}

class Category <<Core Entity>> #E1F5FE {
  + id : Int [PK]
  + name : String
}

class Product <<Core Entity>> #E1F5FE {
  + id : Int [PK]
  + name : String
  + categoryId : Int [FK]
  + price : Int  {VND - Size S}
  + isAvailable : Boolean = true
  + imageUrl : String
  + description : String?
  __
  + getDetails()
  + checkAvailability() : Boolean
}

class Order <<Core Entity>> #FFF9C4 {
  + id : String [PK]
  + userPhone : String [FK -> User.phone]
  + idempotencyKey : String?
  + status : OrderStatus = PENDING
  + total : Int  {Server-side Pricing, FR-05}
  + version : Int = 0  {Optimistic Lock, FR-08}
  + pickupCode : String?  {6 chữ số, Sprint 3 Planned — sinh khi chuyển READY}
  + promotionId : Int? [FK]  {Sprint 3 Planned}
  + discountAmount : Int = 0  {Sprint 3 Planned}
  + createdAt : DateTime
  __
  + calculateTotal() : Int
  + transitionTo(status: OrderStatus)
  + generatePickupCode() : String  {Sprint 3 Planned}
}

class OrderItem <<Core Entity>> #FFF9C4 {
  + id : Int [PK]
  + orderId : String [FK]
  + productId : Int [FK]
  + quantity : Int  {1..99}
  + size : Size = S
  + toppings : String[]
  + unitPrice : Int  {Base + Size + Toppings}
  __
  + getSubtotal() : Int
}

class Payment <<Core Entity>> #E8F5E9 {
  + id : Int [PK]
  + orderId : String [FK]
  + method : PaymentMethod
  + status : PaymentStatus
  + amount : Int  {Matches Order.total}
  + failureReason : String?
  + pointsEarned : Int
  + idempotencyKey : String?
  + createdAt : DateTime
  __
  + processPayment() : Boolean
}

' ========================================================
' EXTENSION CLASSES (MÔ HÌNH MỞ RỘNG, SPRINT 3 PLANNED)
' ========================================================
class Promotion <<Domain Extension (Planned)>> #FFF3E0 {
  + id : Int [PK]
  + code : String [Unique]
  + discountType : DiscountType
  + discountValue : Int
  + minOrderAmount : Int
  + isActive : Boolean = true
  + expiryDate : DateTime?
  __
  + validateVoucher(orderTotal: Int) : Boolean
  + calculateDiscount(orderTotal: Int) : Int
}

class LoyaltyTransaction <<Domain Extension>> #FFF3E0 {
  + id : Int [PK]
  + userPhone : String [FK -> User.phone]
  + orderId : String? [FK]
  + pointsEarned : Int = 0
  + balanceAfter : Int
  + transactionType : String  {EARN}
  + createdAt : DateTime
  __
  + recordTransaction()
}

' ========================================================
' RELATIONSHIPS & MULTIPLICITY
' ========================================================
User "1" *-- "0..*" Order : "places >"
User "1" *-- "0..*" LoyaltyTransaction : "owns >"

Order "1" *-- "1..*" OrderItem : "contains >"
Product "1" <-- "0..*" OrderItem : "references >"
Category "1" <-- "0..*" Product : "categorizes >"

Order "1" *-- "0..*" Payment : "settled by >"
Order "0..*" o-- "0..1" Promotion : "applies > (Sprint 3 Planned)"

LoyaltyTransaction "0..*" --> "0..1" Order : "tied to >"

' Enum dependencies
User ..> Role : uses
Order ..> OrderStatus : uses
OrderItem ..> Size : uses
Payment ..> PaymentMethod : uses
Payment ..> PaymentStatus : uses
Promotion ..> DiscountType : uses

@enduml
