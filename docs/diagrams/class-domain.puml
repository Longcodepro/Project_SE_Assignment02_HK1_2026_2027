@startuml
!theme plain
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12
skinparam roundcorner 10
skinparam shadowing false
skinparam classAttributeIconSize 0

skinparam ClassBorderThickness 1.2
skinparam ClassBorderColor #34495E
skinparam ClassBackgroundColor #FFFFFF
skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1.2

' ========================================================
' ENUMS (DANH MỤC TRẠNG THÁI & HÌNH THỨC)
' ========================================================
enum Role <<Enum>> #F3E5F5 {
  CUSTOMER
  BARISTA
  CASHIER
  MANAGER
}

enum OrderStatus <<Enum>> #F3E5F5 {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType <<Enum>> #F3E5F5 {
  TAKE_AWAY
  DINE_IN
}

enum Size <<Enum>> #F3E5F5 {
  S
  M
  L
}

enum PaymentMethod <<Enum>> #F3E5F5 {
  CARD
  WALLET
  TRANSFER
}

enum PaymentStatus <<Enum>> #F3E5F5 {
  SUCCESS
  FAILED
}

enum DiscountType <<Enum>> #EDE7F6 {
  FIXED
  PERCENT
}

' ========================================================
' CORE DOMAIN CLASSES (CÁC THỰC THỂ CỐT LÕI)
' ========================================================
class User <<Core Entity>> #E8F8F5 {
  + id : Int [PK]
  + phone : String [Unique, 10 digits]
  - passwordHash : String
  + name : String?
  + role : Role = CUSTOMER
  + loyaltyPoints : Int = 0
  + email : String?
  + createdAt : DateTime
  __
  + register(phone, password)
  + login(phone, password)
  + getProfile()
  + addLoyaltyPoints(pts: Int)
}

class Product <<Core Entity>> #E1F5FE {
  + id : Int [PK]
  + name : String
  + category : String
  + price : Int  {VND - Size S}
  + isAvailable : Boolean = true
  + imageUrl : String
  + description : String?
  __
  + getDetails()
  + checkAvailability() : Boolean
}

class Order <<Core Entity>> #FFF9C4 {
  + id : String [PK]
  + userId : Int [FK]
  + idempotencyKey : String?
  + status : OrderStatus = PENDING
  + orderType : OrderType = TAKE_AWAY
  + pickupCode : String?  {6 random digits}
  + total : Int  {Server-side Pricing}
  + version : Int = 0  {Optimistic Lock}
  + promotionId : Int? [FK]
  + discountAmount : Int = 0
  + createdAt : DateTime
  __
  + calculateTotal() : Int
  + transitionTo(status: OrderStatus)
  + generatePickupCode() : String
}

class OrderItem <<Core Entity>> #FFF9C4 {
  + id : Int [PK]
  + orderId : String [FK]
  + productId : Int [FK]
  + quantity : Int  {1..99}
  + size : Size = S
  + toppings : String[]
  + unitPrice : Int  {Base + Size + Toppings}
  __
  + getSubtotal() : Int
}

class Payment <<Core Entity>> #E8F5E9 {
  + id : Int [PK]
  + orderId : String [FK]
  + transactionId : String?  {Gateway Ref}
  + method : PaymentMethod
  + status : PaymentStatus
  + amount : Int  {Matches Order.total}
  + failureReason : String?
  + pointsEarned : Int
  + idempotencyKey : String?
  + createdAt : DateTime
  __
  + processPayment() : Boolean
}

' ========================================================
' EXTENSION CLASSES (MÔ HÌNH MỞ RỘNG)
' ========================================================
class Promotion <<Domain Extension>> #FFF3E0 {
  + id : Int [PK]
  + code : String [Unique]
  + discountType : DiscountType
  + discountValue : Int
  + minOrderAmount : Int
  + isActive : Boolean = true
  + expiryDate : DateTime?
  __
  + validateVoucher(orderTotal: Int) : Boolean
  + calculateDiscount(orderTotal: Int) : Int
}

class LoyaltyTransaction <<Domain Extension>> #FFF3E0 {
  + id : Int [PK]
  + userId : Int [FK]
  + orderId : String? [FK]
  + pointsEarned : Int = 0
  + pointsUsed : Int = 0
  + balanceAfter : Int
  + transactionType : String  {EARN | REDEEM}
  + createdAt : DateTime
  __
  + recordTransaction()
}

' ========================================================
' RELATIONSHIPS & MULTIPLICITY
' ========================================================
User "1" *-- "0..*" Order : "places >"
User "1" *-- "0..*" LoyaltyTransaction : "owns >"

Order "1" *-- "1..*" OrderItem : "contains >"
Product "1" <-- "0..*" OrderItem : "references >"

Order "1" *-- "0..*" Payment : "settled by >"
Order "0..*" o-- "0..1" Promotion : "applies >"

LoyaltyTransaction "0..*" --> "0..1" Order : "tied to >"

' Enum dependencies
User ..> Role : uses
Order ..> OrderStatus : uses
Order ..> OrderType : uses
OrderItem ..> Size : uses
Payment ..> PaymentMethod : uses
Payment ..> PaymentStatus : uses
Promotion ..> DiscountType : uses

@enduml
