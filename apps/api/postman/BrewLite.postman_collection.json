  "item": [
    {
      "name": "01. Health & Docs",
      "item": [
        {
          "name": "GET / - Root Endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Trả chuỗi Hello World!', () => pm.expect(pm.response.text()).to.eql('Hello World!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [] }
          }
        },
        {
          "name": "GET /health - System Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Status là ok', () => pm.expect(res.status).to.eql('ok'));",
                  "pm.test('Có timestamp', () => pm.expect(res.timestamp).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "GET /docs-json - OpenAPI Swagger Schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Tiêu đề API đúng', () => pm.expect(res.info.title).to.eql('BrewLite API'));",
                  "pm.test('Có đường dẫn /products', () => pm.expect(res.paths['/products']).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/docs-json", "host": ["{{baseUrl}}"], "path": ["docs-json"] }
          }
        }
      ]
    },
    {
      "name": "02. Products & Menu",
      "item": [
        {
          "name": "GET /products - Danh sách sản phẩm",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Dữ liệu là mảng không rỗng', () => pm.expect(list).to.be.an('array').that.is.not.empty);",
                  "pm.test('Món đầu tiên có đủ cấu trúc', () => {",
                  "  const p = list[0];",
                  "  pm.expect(p.id).to.be.a('number');",
                  "  pm.expect(p.name).to.be.a('string');",
                  "  pm.expect(p.price).to.be.above(0);",
                  "  pm.expect(p.category).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
