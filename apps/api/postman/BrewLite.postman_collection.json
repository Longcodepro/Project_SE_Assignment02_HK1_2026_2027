            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "POST /orders - Đặt đơn thành công (201 Created)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('idemKeyOrder', 'order-key-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Status là PENDING', () => pm.expect(res.status).to.eql('PENDING'));",
                  "pm.test('Tiền do server tính > 0', () => pm.expect(res.total).to.be.above(0));",
                  "pm.environment.set('createdOrderId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Idempotency-Key", "value": "{{idemKeyOrder}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2,\n      \"size\": \"M\",\n      \"toppings\": [\"tran-chau\"]\n    }\n  ],\n  \"promoCode\": \"WELCOME10\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "POST /orders - Gửi trùng Idempotency-Key (Trả lại đơn cũ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Trả lại đúng ID của đơn vừa tạo', () => pm.expect(res.id).to.eql(pm.environment.get('createdOrderId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Idempotency-Key", "value": "{{idemKeyOrder}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2,\n      \"size\": \"M\",\n      \"toppings\": [\"tran-chau\"]\n    }\n  ],\n  \"promoCode\": \"WELCOME10\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "GET /orders/me - Lịch sử đơn của khách",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Đơn vừa đặt nằm ở đầu danh sách', () => {",
                  "  pm.expect(list[0].id).to.eql(pm.environment.get('createdOrderId'));",
                  "  pm.expect(list[0].status).to.eql('PENDING');",
                  "  pm.environment.set('orderVersion', list[0].version);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/orders/me", "host": ["{{baseUrl}}"], "path": ["orders", "me"] }
          }
        }
