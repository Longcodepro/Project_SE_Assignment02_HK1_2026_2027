{
  "info": {
    "name": "BrewLite API - Comprehensive Test Suite",
    "description": "Bộ kịch bản kiểm thử tích hợp toàn diện cho BrewLite: Auth, Products, Orders, Payments, KDS, Cashier, Reports.",
