    {
      "name": "03. Auth (Xác thực & Đăng nhập)",
      "item": [
        {
          "name": "POST /auth/register - Đăng ký khách hàng mới",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const randomSuffix = Math.floor(10000000 + Math.random() * 90000000);",
                  "pm.environment.set('tempCustomerPhone', '09' + randomSuffix.toString().slice(0, 8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Không chứa passwordHash', () => pm.expect(res.passwordHash).to.be.undefined);",
                  "pm.test('Role mặc định là CUSTOMER', () => pm.expect(res.role).to.eql('CUSTOMER'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{tempCustomerPhone}}\",\n  \"password\": \"matkhau123\",\n  \"name\": \"Khách Hàng Mới\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
