{
  "info": {
    "name": "BrewLite API",
    "description": "Sprint 1: GET / và GET /products. Chạy: npm run postman (cần backend đang chạy).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET / - backend đang chạy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('trả Hello World!', () => pm.expect(pm.response.text()).to.eql('Hello World!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "GET /products - danh sách sản phẩm",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type là JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const body = pm.response.json();",
                  "pm.test('là mảng và không rỗng (đã seed)', () => { pm.expect(body).to.be.an('array').that.is.not.empty; });",
                  "pm.test('mỗi sản phẩm đúng hình dạng API-CONTRACT', () => {",
                  "  body.forEach((p) => {",
                  "    pm.expect(p.id).to.be.a('number');",
                  "    pm.expect(p.name).to.be.a('string').that.is.not.empty;",
                  "    pm.expect(Number.isInteger(p.price) && p.price >= 0, 'price là số nguyên VND').to.be.true;",
                  "    pm.expect(p.imageUrl).to.be.a('string');",
                  "  });",
                  "});",
                  "pm.test('sắp theo id tăng dần', () => { const ids = body.map((p) => p.id); pm.expect(ids).to.eql([...ids].sort((a, b) => a - b)); });",
                  "pm.test('phản hồi dưới 1 giây', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Hợp đồng: docs/API-CONTRACT.md, mục GET /products",
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "GET /khong-ton-tai - route lạ trả 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('body lỗi có statusCode 404', () => pm.expect(pm.response.json().statusCode).to.eql(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/khong-ton-tai",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "khong-ton-tai"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Docs",
      "item": [
        {
          "name": "GET /docs-json - tài liệu Swagger",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('mô tả GET /products', () => pm.expect(pm.response.json().paths['/products'].get).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Có thể import URL này vào Postman (Import > Link) để sinh collection từ Swagger",
            "url": {
              "raw": "{{baseUrl}}/docs-json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs-json"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    }
  ]
}