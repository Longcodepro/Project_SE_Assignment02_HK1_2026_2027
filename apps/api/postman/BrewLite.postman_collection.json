                  "pm.test('Là mảng đơn', () => pm.expect(orders).to.be.an('array'));",
                  "const createdId = pm.environment.get('createdOrderId');",
                  "const target = (orders || []).find(o => o.id === createdId) || (orders && orders[0]);",
                  "if (target && typeof target.version === 'number') {",
                  "  pm.environment.set('kdsVersion', target.version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{baristaToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/kds/orders", "host": ["{{baseUrl}}"], "path": ["kds", "orders"] }
          }
        },
