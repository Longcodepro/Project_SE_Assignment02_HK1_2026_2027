generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id       Int    @id @default(autoincrement())
  name     String
  // VND, size S
  price    Int
  imageUrl String
  orderItems OrderItem[]
}

enum Size {
  S
  M
  L
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
}

model Order {
  id        String      @id
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  // Client gửi lại cùng key thì trả đơn cũ thay vì tạo đơn mới
  idempotencyKey String?
  status    OrderStatus @default(PENDING)
  // VND, tính ở server từ giá sản phẩm + size + topping
  total     Int
  createdAt DateTime    @default(now())
  // Khoá lạc quan: mỗi lần cập nhật đơn phải khớp version đã đọc, rồi tăng thêm 1
  version   Int         @default(0)
  items     OrderItem[]
  payments  Payment[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  size      Size
  toppings  String[]
  // VND, giá 1 ly đã gồm size + topping tại thời điểm đặt
  unitPrice Int

  @@index([orderId])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  // bcrypt hash, không bao giờ trả ra ngoài API
  passwordHash String
  name         String?
  // Tích lũy khi thanh toán thành công (xem payments/loyalty.ts)
  loyaltyPoints Int     @default(0)
  createdAt    DateTime @default(now())
  orders       Order[]
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

// Mỗi lần thử thanh toán là một dòng, nên đơn thất bại có thể thử lại
model Payment {
  id        Int           @id @default(autoincrement())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  method    PaymentMethod
  status    PaymentStatus
  // VND, lấy từ Order.total chứ không nhận từ client
  amount    Int
  failureReason  String?
  // Điểm tích được từ lần thanh toán này, lưu lại để gửi lại cùng key vẫn trả đúng
  pointsEarned   Int           @default(0)
  idempotencyKey String?
  createdAt DateTime      @default(now())

  @@unique([orderId, idempotencyKey])
  @@index([orderId])
}
